[configuration]

config_version=5

[application]

config/name="The Shadows of the Mirror"
config/description="A 16-bit action-adventure RPG inspired by The Legend of Zelda: A Link to the Past"
run/main_scene="res://scenes/main/test_root.tscn"
config/features=PackedStringArray("4.7.1")

[autoload]

"GameManager"="*res://scripts/core/game_manager.gd"
"AudioManager"="*res://scripts/core/audio_manager.gd"

[display]

window/size/viewport_width=256
window/size/viewport_height=224
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

